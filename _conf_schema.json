{
  "rss_url": {
    "description": "RSS 订阅源地址",
    "type": "string",
    "default": "https://lostmedia.wikidot.com/feed/forum/posts.xml"
  },
  "check_interval": {
    "description": "检查间隔（秒）",
    "type": "int",
    "default": 300,
    "hint": "每隔多少秒检查一次"
  },
  "rss_title": {
    "description": "推送消息的标题行",
    "type": "string",
    "default": "失传媒体中文维基 论坛新消息"
  },
  "group_whitelist": {
    "description": "推送群聊白名单（群号列表）",
    "type": "list",
    "default": [],
    "hint": "在 WebUI 中点添加，填入群号即可，如 690941089"
  }
}
